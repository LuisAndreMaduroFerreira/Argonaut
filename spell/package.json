{
  "name": "argonaut-spell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Spell checking for Argonaut: hunspell dictionaries, kept out of the vault's own containers.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc",
    "test": "tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "dictionary-en": "^4.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-pt": "^4.0.0",
    "express": "^4.21.2",
    "hunspell-asm": "^4.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
