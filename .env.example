VITE_API_BASE_URL=http://localhost:8787

# Server-side only (never exposed to the browser bundle — no VITE_ prefix).
LLM_BASE_URL=https://routellm.abacus.ai/v1
LLM_API_KEY=<YOUR_API_KEY>
LLM_MODEL=claude-sonnet-5

# Shown by Argonaut's "Configure assistant" steps, so they can point at this exact file.
# The full path of your .env, for example C:\Users\you\argonaut\.env
SETTINGS_FILE=
